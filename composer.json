{
    "name": "pixelperfectat/module-hyva-cookie-consent",
    "description": "GDPR/ePrivacy-compliant cookie consent management for Hyva theme",
    "type": "magento2-module",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "magento/framework": "^103.0",
        "magento/module-cookie": "*",
        "magento/module-csp": "*",
        "hyva-themes/magento2-theme-module": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "pixelperfectat/coding-standard": "^0.1.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Pixelperfect\\HyvaCookieConsent\\": "src/"
        }
    },
    "scripts": {
        "lint": "parallel-lint --exclude vendor --exclude generated .",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse",
        "test": "phpunit",
        "ci:validate": "@composer validate --no-check-publish",
        "check": [
            "@ci:validate",
            "@lint",
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hyva-themes/magento2-theme-module"
        }
    ]
}
