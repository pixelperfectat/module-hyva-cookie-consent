{
    "name": "pixelperfectat/module-hyva-cookie-consent",
    "description": "GDPR/ePrivacy cookie consent banner for the Magento 2 Hyvä theme, with Google Consent Mode v2 and consent-gated tracking integrations",
    "license": "MIT",
    "type": "magento2-module",
    "keywords": [
        "magento2",
        "magento2-module",
        "hyva",
        "cookie-consent",
        "gdpr",
        "consent-mode"
    ],
    "authors": [
        {
            "name": "Pixelperfect",
            "homepage": "https://github.com/pixelperfectat"
        }
    ],
    "homepage": "https://github.com/pixelperfectat/module-hyva-cookie-consent",
    "support": {
        "issues": "https://github.com/pixelperfectat/module-hyva-cookie-consent/issues",
        "source": "https://github.com/pixelperfectat/module-hyva-cookie-consent"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0",
        "hyva-themes/magento2-theme-module": "^1.3.11",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "magento/module-cookie": "^100.4",
        "magento/module-csp": "^100.4",
        "magento/module-store": "^101.1",
        "magento/module-theme": "^101.1"
    },
    "require-dev": {
        "infection/infection": "^0.35",
        "phpunit/phpunit": "^9.6",
        "pixelperfectat/coding-standard": "^0.2.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.magento.com/"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hyva-themes/magento2-theme-module"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hyva-themes/magento2-mollie-theme-bundle"
        },
        {
            "type": "vcs",
            "url": "https://github.com/hyva-themes/magento2-compat-module-fallback"
        }
    ],
    "autoload": {
        "psr-4": {
            "Pixelperfect\\HyvaCookieConsent\\": "src/"
        },
        "files": [
            "src/registration.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pixelperfect\\HyvaCookieConsent\\Test\\": "Test/"
        }
    },
    "config": {
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "ergebnis/composer-normalize": true,
            "infection/extension-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "check": [
            "@ci:validate",
            "@lint",
            "@cs",
            "@stan",
            "@test",
            "@infection"
        ],
        "ci:normalize": "@composer normalize --dry-run --diff",
        "ci:validate": "@composer validate --no-check-publish",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "infection": "infection --with-uncovered --min-msi=85 --min-covered-msi=90 --threads=max",
        "lint": "parallel-lint --exclude vendor --exclude generated .",
        "stan": "phpstan analyse",
        "test": "phpunit"
    }
}
